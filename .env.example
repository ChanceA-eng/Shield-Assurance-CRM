# Core web CRM. Get these from Supabase > Project Settings > API / Database.
# Use the server connection string for DATABASE_URL. Never use a service-role key
# as a NEXT_PUBLIC_* value.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public production CRM URL; keep this exact origin for signed unsubscribe links.
CRM_WEB_ORIGIN=https://shield-assurance-crm.vercel.app
# Prospect questionnaires: enable only after migration, email verification tests
# and approved private-document retention/scanner setup. No SMS or AI extraction.
CRM_PROSPECT_REQUESTS_ENABLED=false
CRM_PROSPECT_EMAIL_ENABLED=false
CRM_PROSPECT_UPLOADS_ENABLED=false
# Approved private worker only; never run ClamAV inside a Vercel web request.
CRM_PROSPECT_SCANNER_APPROVED=false
CRM_PROSPECT_CLEANUP_APPROVED=false
PROSPECT_CLAMSCAN_PATH=
# Optional private signature directory; the Windows local runner supplies this.
PROSPECT_CLAMAV_DATABASE=
# Generate a long random value and configure the same value in the web deployment
# and any worker calling protected cron endpoints.
CRON_SECRET=

# Optional per-agent Zoom meetings (user-managed General OAuth app).
# Register the same URL in Zoom's OAuth Redirect URL and allowlist.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=https://shield-assurance-crm.vercel.app/api/zoom/callback
# Uses the existing GMAIL_TOKEN_KEYS encryption keyring, not Gmail permissions.

# Transactional/system email through Resend. Cold campaigns use Instantly;
# one-to-one producer follow-ups use a connected Google mailbox.
# Create the sending key in Resend > API Keys,
# restrict it to the verified updates.shield-assurance.com domain, and grant
# sending permission only. Never commit or share the key.
RESEND_API_KEY=
# Use a verified sending subdomain. Route replies directly into the CRM using
# the receiving-enabled subdomain; do not change the root Google mailbox MX.
RESEND_FROM_EMAIL=camani@updates.shield-assurance.com
RESEND_REPLY_TO=replies@updates.shield-assurance.com
# Copy the signing secret shown when creating the Resend webhook below.
# Endpoint: https://shield-assurance-crm.vercel.app/api/email/resend
# Subscribe to email.sent, email.delivered, email.delivery_delayed,
# email.bounced, email.complained, email.failed, email.suppressed, email.received,
# email.opened. Enable domain open tracking and verify its tracking CNAME.
RESEND_WEBHOOK_SECRET=
# Create a separate Resend key with permission to retrieve received email.
RESEND_RECEIVING_API_KEY=
# Match Reply-To for direct replies. Requires verified receiving MX on updates.
RESEND_INBOUND_ADDRESS=replies@updates.shield-assurance.com
# Keep both false until the CRM/database release and authorized end-to-end tests.
RESEND_SENDING_ENABLED=false
RESEND_REPLY_SYNC_READY=false
# Generate a random secret of at least 32 characters. Keep it private and stable;
# changing it invalidates previously issued unsubscribe links.
EMAIL_UNSUBSCRIBE_SECRET=
# Complete real business mailing address required on promotional email footers.
EMAIL_POSTAL_ADDRESS=

# Dedicated cold-campaign delivery through Instantly. Never use producer Gmail
# or the CRM's Resend account for cold prospecting.
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=
# Comma-separated domains reserved for Instantly campaign mailboxes.
INSTANTLY_ALLOWED_SENDER_DOMAINS=

# Optional: AI-assisted drafts, rewrites and Rashi features. OpenAI dashboard API key.
OPENAI_API_KEY=
# One-time carrier guide reading; saved criteria are reused without per-business AI calls.
CARRIER_APPETITE_MODEL=gpt-4.1-mini

# Free government business records. Server-only; never use NEXT_PUBLIC_ names.
# FMCSA WebKey: https://mobile.fmcsa.dot.gov/QCDevsite/docs/apiAccess
# Enables exact-DOT safety enrichment and the legacy name-search adapter.
FMCSA_WEBKEY=
# DOL registration: https://dataportal.dol.gov/registration
# Enables OSHA enrichment on existing leads, not Form 5500 ingestion.
DOL_API_KEY=
# Google Places API (New) key for live Lead Finder keyword search. Enterprise fields: 1,000 free requests/month, then paid.
# Results are shown live and never stored (Google Maps Platform terms). The cap refuses requests beyond it each month.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MONTHLY_CAP=1000
# Public business research. Source activation is owner-managed in Intelligence settings.
# General business discovery indexes public state extracts. This endpoint is for legacy OSM observation refresh only.
# Use suitable commercial-use terms; main Overpass hosting is not a production entitlement.
CRM_RESEARCH_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
CRM_RESEARCH_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Interactive browser tiles only, with provider caching/attribution. No prefetch or bulk tile downloads.
NEXT_PUBLIC_RESEARCH_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Legacy Nest/BullMQ deal-bound email automation is opt-in; its workflow does not send SMS.
CRM_LEGACY_DEAL_BOUND_AUTOMATION_ENABLED=false

# Optional: SMS through Twilio. Copy credentials and sending number from Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Worker/API deployment. The worker needs the same Supabase project URL and
# service-role key as the web server; SUPABASE_URL is the server-only alias.
SUPABASE_URL=
# Optional: separate worker/API deployment; configure when running the worker/API.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional OIP recurring evaluator. Owner settings also control pause/capacity.
# Re-evaluates retained CRM evidence only; never buys data, calls AI or sends mail.
CRM_INTELLIGENCE_WORKER_ENABLED=false
# Keep both publisher flags false until the corresponding migrations and verification gates pass.
# Apply its approved migration first. The CRM pause control defaults to paused.
SOCIAL_TEST_WORKER_ENABLED=false
SOCIAL_REAL_PUBLISHING_ENABLED=false
# Optional direct privileged PostgreSQL URL for worker-only execution RPCs.
# Web Supabase service_role is deliberately not granted these execution commands.
DIRECT_URL=

# Meta Developer App -> Settings > Basic: copy App ID and App Secret to these
# server-only keys. An existing Meta account alone does not provide app credentials.
SOCIAL_META_CONNECTIONS_ENABLED=false
SOCIAL_META_CLIENT_ID=
SOCIAL_META_CLIENT_SECRET=
# Add this exact URL as a Valid OAuth Redirect URI in the Meta app for each environment.
SOCIAL_META_REDIRECT_URI=https://shield-assurance-crm.vercel.app/api/social-marketing/connections/callback
# Set the pinned Graph API version supported by the app, e.g. v27.0.
SOCIAL_META_GRAPH_API_VERSION=
# Generate a random 32-byte key encoded as base64. Keep old versions during rotation.
SOCIAL_TOKEN_KEY_VERSION=v1
# JSON object mapping key version to base64 key, e.g. {"v1":"<base64-32-byte-key>"}.
SOCIAL_TOKEN_KEYS=

# Optional future Threads publishing integration. Threads uses its own Meta app
# use case and its own Threads App ID/App Secret; these are not the Facebook app keys above.
SOCIAL_THREADS_ENABLED=false
SOCIAL_THREADS_CLIENT_ID=
SOCIAL_THREADS_CLIENT_SECRET=
# Register this callback as a valid OAuth redirect URI in the Threads app.
SOCIAL_THREADS_REDIRECT_URI=https://shield-assurance-crm.vercel.app/api/social-marketing/threads/callback
GOOGLE_PLACES_API_KEY=